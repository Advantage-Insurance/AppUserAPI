@page "/"

@using AppUserBlazor.Models
@using AppUserBlazor.Services

@inject ApplicationUserService ApplicationUserService

<PageTitle>API Reference</PageTitle>

<h1>API Reference</h1>

<p class="lead">
     Reference documentation for the User Management API.
</p>

<p>
    This application provides an administrative interface to the User Management API.
    Authentication currently uses Windows Authentication, while application access
    and role assignments are managed through the Security schema in AVI_COMMON.
</p>

<hr />

<h3>Authentication</h3>

<p>
    These endpoints identify the authenticated Windows user and resolve that identity
    to the corresponding user in <code>Security.Users</code>.
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Method</th>
            <th>Endpoint</th>
            <th>Description</th>
        </tr>
    </thead>
    <tbody>
        <tr>
            <td>GET</td>
            <td><code>/auth/whoami</code></td>
            <td>
                Returns information about the currently authenticated Windows identity.
            </td>
        </tr>

    <tr>
        <td>GET</td>
        <td><code>/auth/currentuser</code></td>
        <td>
            Resolves the authenticated Windows identity to the corresponding
            active user in <code>Security.Users</code>.
        </td>
    </tr>
</tbody>

</table>

<hr />

<h3>Current User / Application Authorization</h3>

<p>
    Authentication identifies the user. Application authorization determines whether
    that user has access to a specific application and which role is assigned.
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Method</th>
            <th>Endpoint</th>
            <th>Description</th>
        </tr>
    </thead>
    <tbody>
        <tr>
            <td>GET</td>
            <td><code>/me/applications/{applicationId}</code></td>
            <td>
                Returns the current user's access and role information for a specific
                application.
            </td>
        </tr>
    </tbody>
</table>

<hr />

<h3>Application Users</h3>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Method</th>
            <th>Endpoint</th>
            <th>Description</th>
        </tr>
    </thead>
    <tbody>
        <tr>
            <td>GET</td>
            <td><code>/applicationusers</code></td>
            <td>
                Returns all application/user relationships.
            </td>
        </tr>

    <tr>
        <td>GET</td>
        <td><code>/applicationusers/application/{applicationId}</code></td>
        <td>
            Returns all users assigned to a specific application.
        </td>
    </tr>

    <tr>
        <td>GET</td>
        <td>
            <code>/applicationusers/application/{applicationId}/user/{userId}</code>
        </td>
        <td>
            Returns one specific user/application relationship.
        </td>
    </tr>

    <tr>
        <td>GET</td>
        <td><code>/applicationusers/user/{userId}</code></td>
        <td>
            Returns all application assignments for a specific user.
        </td>
    </tr>
</tbody>

</table>

<hr />

<h3>User Management</h3>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Method</th>
            <th>Endpoint</th>
            <th>Description</th>
        </tr>
    </thead>
    <tbody>
        <tr>
            <td>POST</td>
            <td><code>/users</code></td>
            <td>
                Creates a new user.
            </td>
        </tr>

    <tr>
        <td>POST</td>
        <td><code>/users/{userId}/reactivate</code></td>
        <td>
            Reactivates an existing inactive user.
        </td>
    </tr>

    <tr>
        <td>POST</td>
        <td><code>/users/{userId}/applications</code></td>
        <td>
            Adds an existing user to an application with a specified role.
        </td>
    </tr>

    <tr>
        <td>POST</td>
        <td>
            <code>/users/{userId}/applications/{applicationId}/deactivate</code>
        </td>
        <td>
            Deactivates the user's access to an application.
        </td>
    </tr>

    <tr>
        <td>POST</td>
        <td>
            <code>/users/{userId}/applications/{applicationId}/reactivate</code>
        </td>
        <td>
            Reactivates the user's access to an application.
        </td>
    </tr>

    <tr>
        <td>PUT</td>
        <td>
            <code>/users/{userId}/applications/{applicationId}/role</code>
        </td>
        <td>
            Changes the user's role for a specific application.
        </td>
    </tr>
</tbody>

</table>

<hr />

<h3>Authentication and Audit Behavior</h3>

<div class="alert alert-info">
    <p>
        <strong>Authentication:</strong>
        Protected API endpoints currently use Windows Authentication.
    </p>

<p>
    <strong>Application authorization:</strong>
    Being authenticated does not automatically grant access to an application.
    Application assignments and roles are maintained in the
    <code>Security</code> schema.
</p>

<p class="mb-0">
    <strong>Audit identity:</strong>
    <code>CreatedBy</code> and <code>ModifiedBy</code> are determined by the API
    from the authenticated user. Clients do not supply these values.
</p>

</div>

<hr />

<h3>Current API Base Address</h3>

<p>
    <code>https://localhost:7098</code>
</p>

<p class="text-muted">
    This address reflects the current local development environment and may change
    when the application is hosted.
</p>

@code {
    private List<ApplicationLookup>? applications;
    private List<RoleLookup>? roles;
    private List<SecurityUser>? users;

    protected override async Task OnInitializedAsync()
    {
        applications = await ApplicationUserService.GetApplicationsAsync();

        roles = await ApplicationUserService.GetApplicationRolesAsync(3);

        users = await ApplicationUserService.GetUsersAsync();
    }
}
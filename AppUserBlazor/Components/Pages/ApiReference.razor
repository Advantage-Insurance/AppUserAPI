        </td>
    </tr>

    <tr>
        <td>POST</td>
        <td>
            <code>/users/{userId}/applications/{applicationId}/deactivate</code>
        </td>
        <td>
            Deactivates the user's access to an application.
        </td>
    </tr>

    <tr>
        <td>POST</td>
        <td>
            <code>/users/{userId}/applications/{applicationId}/reactivate</code>
        </td>
        <td>
            Reactivates the user's access to an application.
        </td>
    </tr>

    <tr>
        <td>PUT</td>
        <td>
            <code>/users/{userId}/applications/{applicationId}/role</code>
        </td>
        <td>

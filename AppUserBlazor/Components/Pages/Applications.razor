@page "/applications"

@using AppUserBlazor.Models
@using AppUserBlazor.Services
@inject ApplicationUserService ApplicationUserService

<div class="mb-4">
    <h2 class="mb-1">Application Management</h2>
    <p class="text-muted mb-0">
        Browse applications and their available roles.
    </p>
</div>

<div class="mb-3">
    <button class="btn btn-primary"
            disabled="@(isLoading || isLoadingRoles || isSavingRole || isSavingRoleEdit || isSavingApplicationEdit || isCreatingApplication)"
            @onclick="BeginCreateApplication">
        New Application
    </button>
</div>

@if (showCreateApplication)
{
    <div class="card mb-4">
        <div class="card-header">
            <h5 class="mb-0">New Application</h5>
        </div>
        <div class="card-body">
            @if (!string.IsNullOrEmpty(createApplicationError))
            {
                <div class="alert alert-danger" role="alert">@createApplicationError</div>
            }
            <EditForm Model="@newApplication" OnValidSubmit="SaveNewApplicationAsync">
                <DataAnnotationsValidator />
                <fieldset disabled="@isCreatingApplication">
                    <div class="mb-3">
                        <label for="new-application-code" class="form-label">Application code</label>
                        <InputText id="new-application-code" class="form-control"
                                   maxlength="25" @bind-Value="newApplication.ApplicationCode" />
                        <ValidationMessage For="@(() => newApplication.ApplicationCode)" />
                        <div class="form-text">A stable code used to identify this application.</div>
                    </div>
                    <div class="mb-3">
                        <label for="new-application-name" class="form-label">Application name</label>
                        <InputText id="new-application-name" class="form-control"
                                   maxlength="100" @bind-Value="newApplication.ApplicationName" />
                        <ValidationMessage For="@(() => newApplication.ApplicationName)" />
                    </div>
                    <div class="mb-3">
                        <label for="new-application-description" class="form-label">Description</label>
                        <InputTextArea id="new-application-description" class="form-control"
                                       maxlength="255" rows="2" @bind-Value="newApplication.Description" />
                        <ValidationMessage For="@(() => newApplication.Description)" />
                    </div>
                    <p class="text-muted">New applications start active. Add roles afterward using Roles.</p>
                    <button type="submit" class="btn btn-success">
                        @(isCreatingApplication ? "Saving..." : "Save")
                    </button>
                    <button type="button" class="btn btn-secondary ms-2" @onclick="CancelCreateApplication">
                        Cancel
                    </button>
                </fieldset>
            </EditForm>
        </div>
    </div>
}

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger" role="alert">
        @errorMessage
    </div>
}

@if (isLoading)
{
    <p>Loading applications...</p>
}
else
{
    <div class="card mb-4">
        <div class="card-header">
            <h5 class="mb-0">Applications</h5>
        </div>

        <div class="card-body">
            @if (applications.Count == 0)
            {
                <p class="text-muted mb-0">No applications found.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead>
                            <tr>
                                <th>Application</th>
                                <th>Code</th>
                                <th>Description</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var application in applications)
                            {
                                <tr>
                                    <td>@application.ApplicationName</td>
                                    <td>@application.ApplicationCode</td>
                                    <td>@application.Description</td>
                                    <td>
                                        <StatusBadge IsActive="@application.IsActive" />
                                    </td>
                                    <td>
                                        <div class="d-flex gap-2">
                                            <button class="btn btn-sm btn-primary"
                                                    disabled="@(isLoadingRoles || isSavingRole || isSavingRoleEdit || isSavingApplicationEdit || isCreatingApplication)"
                                                    @onclick="() => ManageAsync(application)">
                                                Roles
                                            </button>

                                            <button class="btn btn-sm btn-secondary"
                                                    disabled="@(isLoadingRoles || isSavingRole || isSavingRoleEdit || isSavingApplicationEdit || isCreatingApplication)"
                                                    @onclick="() => BeginEditApplication(application)">
                                                Edit
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
}

@if (!string.IsNullOrEmpty(applicationSuccessMessage))
{
    <div class="alert alert-success" role="status">
        @applicationSuccessMessage
    </div>
}

@if (!string.IsNullOrEmpty(applicationErrorMessage))
{
    <div class="alert alert-danger" role="alert">
        @applicationErrorMessage
    </div>
}

@if (editingApplicationId is not null)
{
    <div class="card mb-4">
        <div class="card-header">
            <h5 class="mb-0">
                Edit Application — @editingApplicationName
            </h5>
        </div>

        <div class="card-body">
            <EditForm Model="@applicationEdit"
                      OnValidSubmit="SaveApplicationEditAsync">
                <DataAnnotationsValidator />

                <fieldset disabled="@isSavingApplicationEdit">
                    <div class="mb-3">
                        <label for="edit-application-description"
                               class="form-label">
                            Description
                        </label>

                        <InputTextArea id="edit-application-description"
                                       class="form-control"
                                       maxlength="255"
                                       rows="2"
                                       @bind-Value="applicationEdit.Description" />

                        <ValidationMessage For="@(() => applicationEdit.Description)" />
                    </div>

                    <button type="submit" class="btn btn-success">
                        @(isSavingApplicationEdit ? "Saving..." : "Save")
                    </button>

                    <button type="button"
                            class="btn btn-secondary ms-2"
                            @onclick="CancelEditApplication">
                        Cancel
                    </button>
                </fieldset>
            </EditForm>
        </div>
    </div>
}

@if (selectedApplication is not null)
{
    <div class="card">
        <div class="card-header">
            <h5 class="mb-0">
                @selectedApplication.ApplicationName — Roles
            </h5>
        </div>

        <div class="card-body">
            @if (!string.IsNullOrEmpty(roleSuccessMessage))
            {
                <div class="alert alert-success" role="status">
                    @roleSuccessMessage
                </div>
            }

            @if (!string.IsNullOrEmpty(roleErrorMessage))
            {
                <div class="alert alert-danger" role="alert">
                    @roleErrorMessage
                </div>
            }

            @if (!showAddRole)
            {
                <button class="btn btn-primary mb-3"
                        disabled="@(isLoadingRoles || isSavingRoleEdit || !selectedApplication.IsActive)"
                        @onclick="BeginAddRole">
                    Add Role
                </button>
            }
            else
            {
                <div class="border rounded p-3 mb-3">
                    <h6>Add Role — @selectedApplication.ApplicationName</h6>

                    <EditForm Model="@newRole" OnValidSubmit="SaveRoleAsync">
                        <DataAnnotationsValidator />

                        <fieldset disabled="@isSavingRole">
                            <div class="mb-3">
                                <label for="new-role-name" class="form-label">
                                    Role name
                                </label>
                                <InputText id="new-role-name"
                                           class="form-control"
                                           maxlength="50"
                                           @bind-Value="newRole.RoleName" />
                                <ValidationMessage For="@(() => newRole.RoleName)" />
                            </div>

                            <div class="mb-3">
                                <label for="new-role-description" class="form-label">
                                    Description
                                </label>
                                <InputTextArea id="new-role-description"
                                               class="form-control"
                                               maxlength="255"
                                               rows="2"
                                               @bind-Value="newRole.Description" />
                                <ValidationMessage For="@(() => newRole.Description)" />
                            </div>

                            <button type="submit" class="btn btn-success">
                                @(isSavingRole ? "Saving..." : "Save Role")
                            </button>

                            <button type="button"
                                    class="btn btn-secondary ms-2"
                                    @onclick="CancelAddRole">
                                Cancel
                            </button>
                        </fieldset>
                    </EditForm>
                </div>
            }

            @if (editingRoleId is not null)
            {
                <div class="border rounded p-3 mb-3">
                    <h6>Edit Role — @editingRoleName</h6>

                    <EditForm Model="@roleEdit" OnValidSubmit="SaveRoleEditAsync">
                        <DataAnnotationsValidator />

                        <fieldset disabled="@isSavingRoleEdit">
                            <div class="mb-3">
                                <label for="edit-role-description" class="form-label">
                                    Description
                                </label>

                                <InputTextArea id="edit-role-description"
                                               class="form-control"
                                               maxlength="255"
                                               rows="2"
                                               @bind-Value="roleEdit.Description" />

                                <ValidationMessage For="@(() => roleEdit.Description)" />
                            </div>

                            <button type="submit" class="btn btn-success">
                                @(isSavingRoleEdit ? "Saving..." : "Save")
                            </button>

                            <button type="button"
                                    class="btn btn-secondary ms-2"
                                    @onclick="CancelEditRole">
                                Cancel
                            </button>
                        </fieldset>
                    </EditForm>
                </div>
            }

            @if (isLoadingRoles)
            {
                <p>Loading roles...</p>
            }
            else if (roles.Count == 0)
            {
                <p class="text-muted mb-0">
                    No roles defined for this application.
                </p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table align-middle">
                        <thead>
                            <tr>
                                <th>Role</th>
                                <th>Description</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var role in roles)
                            {
                                <tr>
                                    <td>@role.RoleName</td>
                                    <td>@role.Description</td>
                                    <td>
                                        <StatusBadge IsActive="@role.IsActive" />
                                    </td>
                                    <td>
                                        <button class="btn btn-sm btn-secondary"
                                                disabled="@(isSavingRole || isSavingRoleEdit)"
                                                @onclick="() => BeginEditRole(role)">
                                            Edit
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
}

@code {

    private CreateApplicationRequest newApplication = new();
    private bool showCreateApplication;
    private bool isCreatingApplication;
    private string? createApplicationError;

    private void BeginCreateApplication()
    {
        selectedApplication = null;
        roles.Clear();
        showAddRole = false;
        editingRoleId = null;
        editingRoleName = null;
        roleEdit = new();
        editingApplicationId = null;
        editingApplicationName = null;
        applicationEdit = new();
        applicationSuccessMessage = null;
        applicationErrorMessage = null;
        roleSuccessMessage = null;
        roleErrorMessage = null;
        newApplication = new();
        createApplicationError = null;
        showCreateApplication = true;
    }

    private void CancelCreateApplication()
    {
        showCreateApplication = false;
        newApplication = new();
        createApplicationError = null;
    }

    private async Task SaveNewApplicationAsync()
    {
        if (isCreatingApplication)
            return;

        isCreatingApplication = true;
        createApplicationError = null;
        applicationSuccessMessage = null;
        applicationErrorMessage = null;

        try
        {
            var result = await ApplicationUserService.CreateApplicationAsync(newApplication);

            if (result is null || result.ReturnCode != 0)
            {
                createApplicationError = result?.Message ?? "Unable to confirm application creation.";
                return;
            }

            CancelCreateApplication();
            applicationSuccessMessage = result.Message;

            try
            {
                applications = await ApplicationUserService.GetApplicationsAsync()
                    ?? new List<ApplicationLookup>();
            }
            catch (Exception)
            {
                applicationErrorMessage = "The application was created, but the list could not be refreshed. Reload the page to view it.";
            }
        }
        catch (InvalidOperationException ex)
        {
            createApplicationError = ex.Message;
        }
        catch (Exception)
        {
            createApplicationError = "Unable to confirm whether the application was created. Reload the application list before trying again.";
        }
        finally
        {
            isCreatingApplication = false;
        }
    }

    private List<ApplicationLookup> applications = new();
    private List<RoleLookup> roles = new();
    private ApplicationLookup? selectedApplication;
    private string? errorMessage;
    private bool isLoading = true;
    private bool isLoadingRoles;

    private int? editingRoleId;
    private string? editingRoleName;
    private UpdateApplicationRoleDescriptionRequest roleEdit = new();
    private bool isSavingRoleEdit;

    private int? editingApplicationId;
    private string? editingApplicationName;
    private UpdateApplicationDescriptionRequest applicationEdit = new();
    private bool isSavingApplicationEdit;
    private string? applicationSuccessMessage;
    private string? applicationErrorMessage;

    private void BeginEditApplication(ApplicationLookup application)
    {
        CancelCreateApplication();
        // Close the roles section while editing an application.
        selectedApplication = null;
        roles.Clear();
        showAddRole = false;
        editingRoleId = null;
        editingRoleName = null;
        roleSuccessMessage = null;
        roleErrorMessage = null;

        applicationSuccessMessage = null;
        applicationErrorMessage = null;

        editingApplicationId = application.ApplicationID;
        editingApplicationName = application.ApplicationName;

        applicationEdit = new()
        {
            Description = application.Description
        };
    }

    private void CancelEditApplication()
    {
        editingApplicationId = null;
        editingApplicationName = null;
        applicationEdit = new();
        applicationErrorMessage = null;
    }

    private async Task SaveApplicationEditAsync()
    {
        if (editingApplicationId is null || isSavingApplicationEdit)
            return;

        var applicationId = editingApplicationId.Value;

        isSavingApplicationEdit = true;
        applicationSuccessMessage = null;
        applicationErrorMessage = null;

        try
        {
            var result =
                await ApplicationUserService.UpdateApplicationDescriptionAsync(
                    applicationId,
                    applicationEdit);

            if (result is null
                || (result.ReturnCode != 0 && result.ReturnCode != 4))
            {
                applicationErrorMessage = result?.Message
                    ?? "Unable to confirm the description update.";
                return;
            }

            editingApplicationId = null;
            editingApplicationName = null;
            applicationEdit = new();
            applicationSuccessMessage = result.Message;

            try
            {
                applications =
                    await ApplicationUserService.GetApplicationsAsync()
                    ?? new List<ApplicationLookup>();
            }
            catch (Exception)
            {
                applicationErrorMessage =
                    "The save completed, but the application list could not "
                    + "be refreshed. Reload the page to view the current data.";
            }
        }
        catch (InvalidOperationException ex)
        {
            applicationErrorMessage = ex.Message;
        }
        catch (Exception)
        {
            applicationErrorMessage =
                "Unable to confirm whether the description was updated. "
                + "Reload the page before trying again.";
        }
        finally
        {
            isSavingApplicationEdit = false;
        }
    }

    private void BeginEditRole(RoleLookup role)
    {
        showAddRole = false;
        roleSuccessMessage = null;
        roleErrorMessage = null;

        editingRoleId = role.RoleID;
        editingRoleName = role.RoleName;

        roleEdit = new()
        {
            Description = role.Description
        };
    }

    private void CancelEditRole()
    {
        editingRoleId = null;
        editingRoleName = null;
        roleEdit = new();
        roleErrorMessage = null;
    }

    private async Task SaveRoleEditAsync()
    {
        if (selectedApplication is null
            || editingRoleId is null
            || isSavingRoleEdit)
        {
            return;
        }

        var applicationId = selectedApplication.ApplicationID;
        var roleId = editingRoleId.Value;

        isSavingRoleEdit = true;
        roleSuccessMessage = null;
        roleErrorMessage = null;

        try
        {
            var result =
                await ApplicationUserService.UpdateApplicationRoleDescriptionAsync(
                    applicationId,
                    roleId,
                    roleEdit);

            if (result is null
                || (result.ReturnCode != 0 && result.ReturnCode != 4))
            {
                roleErrorMessage = result?.Message
                    ?? "Unable to confirm the description update.";
                return;
            }

            editingRoleId = null;
            editingRoleName = null;
            roleEdit = new();
            roleSuccessMessage = result.Message;

            try
            {
                roles =
                    await ApplicationUserService.GetApplicationRolesAsync(
                        applicationId)
                    ?? new List<RoleLookup>();
            }
            catch (Exception)
            {
                roleErrorMessage =
                    "The save completed, but the list could not be refreshed. "
                    + "Select Roles again to reload it.";
            }
        }
        catch (InvalidOperationException ex)
        {
            roleErrorMessage = ex.Message;
        }
        catch (Exception)
        {
            roleErrorMessage =
                "Unable to confirm whether the description was updated. "
                + "Reload the role list before trying again.";
        }
        finally
        {
            isSavingRoleEdit = false;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            applications =
                await ApplicationUserService.GetApplicationsAsync()
                ?? new List<ApplicationLookup>();
        }
        catch (Exception)
        {
            errorMessage = "Unable to load applications. Please try again.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ManageAsync(ApplicationLookup application)
    {
        CancelCreateApplication();
        editingRoleId = null;
        editingRoleName = null;
        roleEdit = new();
        errorMessage = null;
        selectedApplication = application;
        roles.Clear();
        isLoadingRoles = true;
        showAddRole = false;
        newRole = new();
        roleSuccessMessage = null;
        roleErrorMessage = null;
        editingApplicationId = null;
        editingApplicationName = null;
        applicationEdit = new();
        applicationSuccessMessage = null;
        applicationErrorMessage = null;

        try
        {
            roles =
                await ApplicationUserService.GetApplicationRolesAsync(
                    application.ApplicationID)
                ?? new List<RoleLookup>();
        }
        catch (Exception)
        {
            errorMessage = "Unable to load roles. Please select Manage again.";
            selectedApplication = null;
        }
        finally
        {
            isLoadingRoles = false;
        }
    }

    private CreateApplicationRoleRequest newRole = new();
    private bool showAddRole;
    private bool isSavingRole;
    private string? roleSuccessMessage;
    private string? roleErrorMessage;

    private void BeginAddRole()
    {
        editingRoleId = null;
        editingRoleName = null;
        roleEdit = new();
        newRole = new();
        roleSuccessMessage = null;
        roleErrorMessage = null;
        showAddRole = true;
    }

    private void CancelAddRole()
    {
        showAddRole = false;
        newRole = new();
        roleErrorMessage = null;
    }

    private async Task SaveRoleAsync()
    {
        if (selectedApplication is null || isSavingRole)
            return;

        var applicationId = selectedApplication.ApplicationID;

        isSavingRole = true;
        roleSuccessMessage = null;
        roleErrorMessage = null;

        try
        {
            var result =
                await ApplicationUserService.CreateApplicationRoleAsync(
                    applicationId, newRole);

            if (result is null || result.ReturnCode != 0)
            {
                roleErrorMessage = result?.Message
                    ?? "Unable to confirm role creation.";
                return;
            }

            showAddRole = false;
            newRole = new();
            roleSuccessMessage = result.Message;

            try
            {
                roles =
                    await ApplicationUserService.GetApplicationRolesAsync(
                        applicationId)
                    ?? new List<RoleLookup>();
            }
            catch (Exception)
            {
                roleErrorMessage =
                    "The role was created, but the list could not be refreshed. "
                    + "Select Manage again to reload it.";
            }
        }
        catch (InvalidOperationException ex)
        {
            roleErrorMessage = ex.Message;
        }
        catch (Exception)
        {
            roleErrorMessage =
                "Unable to confirm whether the role was created. "
                + "Reload the role list before trying again.";
        }
        finally
        {
            isSavingRole = false;
        }
    }
}
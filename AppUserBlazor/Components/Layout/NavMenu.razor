@using AppUserBlazor.Models
@using AppUserBlazor.Services

@inject ApplicationUserService ApplicationUserService

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">AVI App User Console</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable"
     onclick="document.querySelector('.navbar-toggler').click()">

    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <svg class="navigation-icon"
                     viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="1.7"
                     stroke-linecap="round"
                     stroke-linejoin="round"
                     aria-hidden="true"
                     focusable="false">
                    <path d="M14 2H5a1 1 0 0 0-1 1v18a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1V8Z" />
                    <path d="M14 2v6h6" />
                    <path d="m9 12-3 3 3 3m6-6 3 3-3 3" />
                </svg>
                <span>API Reference</span>
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="applicationusers">
                <svg class="navigation-icon"
                     viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="1.7"
                     stroke-linecap="round"
                     stroke-linejoin="round"
                     aria-hidden="true"
                     focusable="false">
                    <circle cx="9" cy="7" r="4" />
                    <path d="M2 21v-2a7 7 0 0 1 14 0v2Z" />
                    <path d="M17 3a4 4 0 0 1 0 8m2 4a6 6 0 0 1 3 5v1h-3" />
                </svg>
                <span>User Management</span>
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="applications">
                <svg class="navigation-icon"
                     viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="1.7"
                     stroke-linecap="round"
                     stroke-linejoin="round"
                     aria-hidden="true"
                     focusable="false">
                    <rect x="3" y="3" width="7" height="7" rx="1.5" />
                    <rect x="14" y="3" width="7" height="7" rx="1.5" />
                    <rect x="3" y="14" width="7" height="7" rx="1.5" />
                    <rect x="14" y="14" width="7" height="7" rx="1.5" />
                </svg>
                <span>Application Management</span>
            </NavLink>
        </div>
    </nav>

    @if (currentUser is not null)
    {
        <div class="signed-in-user">
            <div class="signed-in-label">
                Signed in as
            </div>

            <div class="signed-in-name">
                @currentUser.UserName
            </div>

            @if (!string.IsNullOrWhiteSpace(currentUser.Email))
            {
                <div class="signed-in-email">
                    @currentUser.Email
                </div>
            }
        </div>
    }


</div>

@code {
    private CurrentSecurityUser? currentUser;

    protected override async Task OnInitializedAsync()
    {
        currentUser = await ApplicationUserService.GetCurrentUserAsync();
    }
}